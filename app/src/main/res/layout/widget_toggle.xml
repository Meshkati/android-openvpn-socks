<?xml version="1.0" encoding="utf-8"?>
<!-- The 1×1 widget (Widgets.toggleViews). The whole widget is the button.
     Under it, a dot for OpenVPN and one for VLESS, joined by a line that
     turns solid when both are connected. Drawn as Off; also the picker preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/connect"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/widget_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_button_off" />

            <ImageView
                android:id="@+id/widget_button_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_power" />

            <ProgressBar
                android:id="@+id/widget_spinner"
                style="?android:attr/progressBarStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                android:indeterminateTint="@color/warn"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mini_openvpn"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_mini_idle" />

            <ImageView
                android:id="@+id/mini_line"
                android:layout_width="9dp"
                android:layout_height="2dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_line_idle" />

            <ImageView
                android:id="@+id/mini_vless"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_mini_idle" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
