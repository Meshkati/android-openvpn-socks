<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    style="@style/Screen"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout style="@style/AppBar">

        <TextView
            style="@style/AppBarTitle"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/open_log"
            style="@style/IconButton"
            android:contentDescription="@string/log"
            android:src="@drawable/ic_log" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout style="@style/Content">

            <io.github.meshkati.ovpnvless.PowerToggle
                android:id="@+id/toggle"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/state"
                style="@style/Text.State"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/hint"
                style="@style/Text.Hint"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/error_box"
                style="@style/Notice.Error"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <ImageView
                    style="@style/NoticeIcon"
                    android:src="@drawable/ic_alert"
                    android:tint="@color/err" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/error_text"
                        style="@style/Text"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/error_raw"
                        style="@style/Text"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/muted"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/view_log"
                        style="@style/Button.Text"
                        android:layout_height="40dp"
                        android:layout_marginStart="-12dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="-8dp"
                        android:text="@string/view_log" />
                </LinearLayout>
            </LinearLayout>

            <io.github.meshkati.ovpnvless.RouteCard
                android:id="@+id/route"
                style="@style/Card"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/route_caption"
                    style="@style/Text.Caption" />

                <io.github.meshkati.ovpnvless.HopView
                    android:id="@+id/hop_openvpn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <io.github.meshkati.ovpnvless.HopView
                    android:id="@+id/hop_vless"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </io.github.meshkati.ovpnvless.RouteCard>

            <LinearLayout
                android:id="@+id/otp_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Label"
                    android:labelFor="@+id/otp"
                    android:text="@string/otp_label" />

                <EditText
                    android:id="@+id/otp"
                    style="@style/Field.Code" />

                <TextView
                    android:id="@+id/otp_help"
                    style="@style/Text.Help"
                    android:text="@string/otp_help" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/info_box"
                style="@style/Notice.Info"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <ImageView
                    style="@style/NoticeIcon"
                    android:src="@drawable/ic_info"
                    android:tint="@color/muted" />

                <TextView
                    android:id="@+id/info_text"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Public IP check, connected through VLESS only -->
            <LinearLayout
                android:id="@+id/ip_box"
                style="@style/Card"
                android:layout_marginTop="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Caption"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/ip_check_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/ip_value"
                            style="@style/Text"
                            android:accessibilityLiveRegion="polite"
                            android:fontFamily="sans-serif-medium"
                            android:saveEnabled="false"
                            android:textIsSelectable="true"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/ip_meta"
                            style="@style/Text"
                            android:layout_marginTop="2dp"
                            android:saveEnabled="false"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/check_ip"
                        style="@style/Button.Line"
                        android:layout_marginStart="12dp"
                        android:text="@string/check_ip" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ip_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_log"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp"
                    android:saveEnabled="false"
                    android:textColor="@color/log_text"
                    android:textIsSelectable="true"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
