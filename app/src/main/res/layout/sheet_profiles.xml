<?xml version="1.0" encoding="utf-8"?>
<!-- The profile picker (ProfilePicker): a bottom sheet over the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        style="@style/Text"
        android:layout_width="match_parent"
        android:accessibilityHeading="true"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:text="@string/profiles_title"
        android:textSize="18sp" />

    <!-- While connected: picking another profile reconnects. -->
    <TextView
        android:id="@+id/sheet_note"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_sheet_note"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="10dp"
        android:drawableTint="@color/muted"
        android:padding="12dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/sheet_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/sheet_new"
        style="@style/SheetAction"
        android:drawableStart="@drawable/ic_plus"
        android:text="@string/profiles_new" />

    <TextView
        android:id="@+id/sheet_manage"
        style="@style/SheetAction"
        android:drawableStart="@drawable/ic_profiles"
        android:text="@string/profiles_manage" />
</LinearLayout>
