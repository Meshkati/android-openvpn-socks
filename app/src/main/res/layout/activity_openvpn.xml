<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    style="@style/Screen"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout style="@style/AppBar">

        <ImageButton
            android:id="@+id/back"
            style="@style/IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/AppBarTitle"
            android:layout_marginStart="4dp"
            android:text="@string/openvpn_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout style="@style/Content">

            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_summary_icon"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_file"
                        android:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/summary_title"
                            style="@style/Text"
                            android:layout_width="match_parent"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/summary_meta"
                            style="@style/Text"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <Button
                        android:id="@+id/import_file"
                        style="@style/Button.Tone"
                        android:drawableStart="@drawable/ic_file"
                        android:text="@string/import_file" />

                    <Button
                        android:id="@+id/edit_text"
                        style="@style/Button.Line"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/ic_edit"
                        android:text="@string/edit_text" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Section"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="@string/sign_in" />

            <TextView
                style="@style/Text.Label"
                android:labelFor="@+id/username"
                android:text="@string/username" />

            <EditText
                android:id="@+id/username"
                style="@style/Field"
                android:autofillHints="username"
                android:inputType="text|textNoSuggestions" />

            <TextView
                style="@style/Text.Label"
                android:layout_marginTop="16dp"
                android:labelFor="@+id/password"
                android:text="@string/password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/password"
                    style="@style/Field"
                    android:autofillHints="password"
                    android:inputType="textPassword"
                    android:paddingEnd="52dp" />

                <ImageButton
                    android:id="@+id/toggle_password"
                    style="@style/IconButton"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/show_password"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <TextView
                style="@style/Text.Help"
                android:text="@string/sign_in_help" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="32dp" />

            <TextView
                style="@style/Text"
                android:layout_gravity="center_horizontal"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="6dp"
                android:drawableTint="@color/muted"
                android:gravity="center"
                android:paddingTop="16dp"
                android:text="@string/saved_locally"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
