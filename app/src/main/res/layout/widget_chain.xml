<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×2 widget (Widgets.chainViews): the button on the left, the route's
     two steps on the right, like the home screen's route card. The line
     between the steps' dots is drawn in three pieces (below the OpenVPN dot,
     between the rows, above the VLESS dot) and turns solid when both are
     connected. Tapping anywhere but the button opens the app. Under the
     button, the state and, with more than one profile, the profile in use.
     Drawn as Off; also the picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/widget_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/connect">

            <ImageView
                android:id="@+id/widget_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_button_off" />

            <ImageView
                android:id="@+id/widget_button_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_power" />

            <ProgressBar
                android:id="@+id/widget_spinner"
                style="?android:attr/progressBarStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:indeterminate="true"
                android:indeterminateTint="@color/warn"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_off"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <!-- The profile in use, once there is more than one. -->
        <TextView
            android:id="@+id/widget_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_line_idle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- OpenVPN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="18dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />

                <FrameLayout
                    android:layout_width="18dp"
                    android:layout_height="18dp">

                    <ImageView
                        android:id="@+id/hop_openvpn_dot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot_idle" />

                    <ImageView
                        android:id="@+id/hop_openvpn_icon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/line_openvpn"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_line_idle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/hop_openvpn"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/hop_openvpn_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hop_openvpn_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/hop_not_started"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/line_between"
            android:layout_width="2dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_line_idle" />

        <!-- VLESS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="18dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/line_vless"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_line_idle" />

                <FrameLayout
                    android:layout_width="18dp"
                    android:layout_height="18dp">

                    <ImageView
                        android:id="@+id/hop_vless_dot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot_idle" />

                    <ImageView
                        android:id="@+id/hop_vless_icon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/hop_vless"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/hop_vless_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hop_vless_meta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/hop_not_started"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <!-- The home screen's public IP check: "IP ✓" once it got an answer through VLESS. -->
                    <TextView
                        android:id="@+id/widget_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:drawablePadding="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/widget_ip"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
