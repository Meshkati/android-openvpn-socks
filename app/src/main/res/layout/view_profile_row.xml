<?xml version="1.0" encoding="utf-8"?>
<!-- One profile (ProfileRow): in the picker sheet, and on the Profiles screen
     with an "In use" label and a menu button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <io.github.meshkati.ovpnvless.ProfileBadge
        android:id="@+id/row_badge"
        android:layout_width="32dp"
        android:layout_height="32dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_name"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/row_in_use"
                style="@style/Text"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_in_use"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:paddingTop="1dp"
                android:paddingEnd="8dp"
                android:paddingBottom="1dp"
                android:text="@string/profiles_in_use"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_meta"
            style="@style/Text"
            android:layout_width="match_parent"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/row_more"
        style="@style/IconButton"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_more"
        android:visibility="gone" />

    <!-- Keeps the picker's rows clear of the edge, where there is no menu button. -->
    <Space
        android:layout_width="4dp"
        android:layout_height="0dp" />
</LinearLayout>
