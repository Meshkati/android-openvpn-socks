<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Platform: light here, dark in values-night.
      Versioned: adds API 27+ items in values-v27.
      Theme.Chain: everything else, shared by both.
    -->
    <style name="Platform.Theme.Chain" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Versioned.Theme.Chain" parent="Platform.Theme.Chain">
        <!-- API 26 can't draw dark navigation bar icons, so keep a scrim behind them. -->
        <item name="android:navigationBarColor">@color/nav_scrim</item>
    </style>

    <style name="Theme.Chain" parent="Versioned.Theme.Chain">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textColorHighlight">@color/accent_soft</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>
</resources>
