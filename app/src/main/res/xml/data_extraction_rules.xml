<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or moved to a new phone. allowBackup="false" stops
  cloud backups, but from Android 12 not device-to-device transfers, which
  would copy the profiles. Their secrets are sealed with a Keystore key that
  stays on this phone (Secrets.kt), so they would not open there anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
